# Copy to .env and fill in your values. Never commit .env.

# Required: OpenRouter API key for hosted LLM/embedding calls
OPENROUTER_API_KEY=sk-or-...

# Whether to use hosted models (true) or local HuggingFace models (false)
# When false, bge_small_en_v15 and minilm_l6_v2 run locally; no LLM calls are billed.
USE_HOSTED=true

# HuggingFace model cache directory (used by local embedders)
HF_HOME=~/.cache/huggingface

# Optional: override config path (default: configs/experiment_matrix.yaml)
# CONFIG=configs/experiment_matrix.yaml

# Optional: log level (default: INFO)
# LOG_LEVEL=INFO
